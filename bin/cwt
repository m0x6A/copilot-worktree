#!/usr/bin/env bash
set -euo pipefail

# Ensure we're in a git repo
git_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "Error: not inside a git repository" >&2
    exit 1
}

# Find a dictionary file (Fedora, Ubuntu/Debian, macOS, fallbacks)
wordlist=""
for f in \
    /usr/share/dict/words \
    /usr/share/dict/american-english \
    /usr/share/dict/british-english \
    /usr/share/dict/web2 \
    /usr/share/cracklib/cracklib-small; do
    if [ -f "$f" ]; then
        wordlist="$f"
        break
    fi
done

if [ -z "$wordlist" ]; then
    echo "Error: no dictionary file found." >&2
    echo "Install one for your platform:" >&2
    echo "  Fedora:        sudo dnf install words" >&2
    echo "  Ubuntu/Debian: sudo apt install wamerican" >&2
    echo "  Arch:          sudo pacman -S words" >&2
    echo "  macOS:         (should exist at /usr/share/dict/words)" >&2
    exit 1
fi

# Generate 3 random words (lowercase, alpha-only, 4-8 chars)
# Use shuf if available, otherwise fall back to awk (for macOS without coreutils)
pick_random() {
    if command -v shuf >/dev/null 2>&1; then
        shuf -n3
    else
        awk 'BEGIN{srand()} {print rand(), $0}' | sort -n | head -3 | cut -d' ' -f2-
    fi
}
name=$(grep -E '^[a-z]{4,8}$' "$wordlist" | pick_random | paste -sd'-')

# Create worktree
worktree_dir="$git_root/.github/worktrees/$name"
mkdir -p "$git_root/.github/worktrees"
git worktree add "$worktree_dir" -b "$name"

echo "Worktree created: $worktree_dir"
echo "Starting GitHub Copilot..."

cd "$worktree_dir"
exec gh copilot
